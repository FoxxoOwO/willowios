Subject: [PATCH 956/956] willow: instrument bsd_init with visible printf checkpoints

--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -490,10 +490,10 @@
 	platform_stall_panic_or_spin(PLATFORM_STALL_XNU_LOCATION_BSD_INIT);
 #endif
 
-#define DEBUG_BSDINIT 0
+#define DEBUG_BSDINIT 1
 
 #if DEBUG_BSDINIT
-#define bsd_init_kprintf(x, ...) kprintf("bsd_init: " x, ## __VA_ARGS__)
+#define bsd_init_kprintf(x, ...) printf("bsd_init: " x, ## __VA_ARGS__)
 #else
 #define bsd_init_kprintf(x, ...)
 #endif
@@ -501,6 +501,7 @@
 	throttle_init();
 
 	printf(copyright);
+	printf("bsd_init: [1] copyright banner done\n");
 
 #if CONFIG_DEV_KMEM
 	bsd_init_kprintf("calling dev_kmem_init\n");
@@ -509,9 +510,12 @@
 
 	/* Initialize kauth subsystem before instancing the first credential */
 	bsd_init_kprintf("calling kauth_init\n");
+	printf("bsd_init: [2] calling kauth_init\n");
 	kauth_init();
+	printf("bsd_init: [2.1] kauth_init done\n");
 
 	/* kernel_task->proc = kernproc; */
+	printf("bsd_init: [3] set_bsdtask_info\n");
 	set_bsdtask_info(kernel_task, (void *)kernproc);
 
 	/* Set the parent of kernproc to itself */
@@ -532,15 +536,19 @@
 
 	/* set the cred */
 	kauth_cred_set(&kernproc_ro_data.p_ucred, vfs_context0.vc_ucred);
+	printf("bsd_init: [4] calling proc_ro_alloc\n");
 	kernproc->p_proc_ro = proc_ro_alloc(kernproc, &kernproc_ro_data,
 	    kernel_task, &kerntask_ro_data);
+	printf("bsd_init: [4.1] proc_ro_alloc done\n");
 
 	/* give kernproc a name */
 	bsd_init_kprintf("calling process_name\n");
+	printf("bsd_init: [5] calling process_name\n");
 	process_name("kernel_task", kernproc);
 
 	/* Allocate proc lock attribute */
 
+	printf("bsd_init: [6] mutex and fdt init\n");
 	lck_mtx_init(&kernproc->p_mlock, &proc_mlock_grp, &proc_lck_attr);
 	lck_mtx_init(&kernproc->p_ucred_mlock, &proc_ucred_mlock_grp, &proc_lck_attr);
 	lck_spin_init(&kernproc->p_slock, &proc_slock_grp, &proc_lck_attr);
@@ -552,8 +560,10 @@
 	assert(bsd_simul_execs != 0);
 	execargs_cache_size = bsd_simul_execs;
 	execargs_free_count = bsd_simul_execs;
+	printf("bsd_init: [7] zalloc_permanent execargs\n");
 	execargs_cache = zalloc_permanent(bsd_simul_execs * sizeof(vm_offset_t),
 	    ZALIGN(vm_offset_t));
+	printf("bsd_init: [7.1] execargs done\n");
 
 	if (current_task() != kernel_task) {
 		printf("bsd_init: We have a problem, "
@@ -561,13 +571,17 @@
 	}
 
 	bsd_init_kprintf("calling get_bsdthread_info\n");
+	printf("bsd_init: [8] current_uthread\n");
 	ut = current_uthread();
+	printf("bsd_init: [8.1] current_uthread done\n");
 
 #if CONFIG_MACF
 	/*
 	 * Initialize the MAC Framework
 	 */
+	printf("bsd_init: [9] calling mac_policy_initbsd\n");
 	mac_policy_initbsd();
+	printf("bsd_init: [9.1] mac_policy_initbsd done\n");
 
 #if defined (__i386__) || defined (__x86_64__)
 	/*
