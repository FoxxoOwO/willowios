Subject: [PATCH 951/954] willow: board splash 0x5c000000 (1080x2340), HID geometry & low-DDR GPU pool

diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,11 +515,7 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-#if defined(TOPAZ_4K)
-	MOV64	x0, (0x5c000000 + 2368 * 4320)	/* topaz splash framebuffer */
-#else
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
-#endif
+	MOV64	x0, (0x5c000000 + 2308 * 4320)	/* willow splash framebuffer (1080x2340) */
 	mov		w1, #-1
 	mov		x2, #32
 	mov		x4, #4320
@@ -712,7 +708,7 @@ Ltopaz_fb_block:
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	MOV64	x10, 0x5c000000
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1877,7 +1877,7 @@ sweet_early_map_final(void)
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	*slot = 0x5c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -11,14 +11,11 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-#if defined(TOPAZ_4K)
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x5c000000;  /* topaz splash */
-#else
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
-#endif
+/* willow (SM6125): cont_splash_region @ 0x5c000000, 1080x2340 BGRX8888 */
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x5c000000;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
+#define EARLY_HEIGHT 2340u
 #define EARLY_STRIDE (4320u / 4)
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -435,9 +435,9 @@
 	int native = 0;
 	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
 	fLogicalW = native ? 1080 : 1125;
-	fLogicalH = native ? 2400 : 2436;
+	fLogicalH = native ? 2340 : 2436;
 	fOffX = ((fLogicalW - 1080) / 2) & ~3;           /* as SweetFramebuffer.cpp */
-	fOffY = (fLogicalH - 2400) / 2;
+	fOffY = (fLogicalH - 2340) / 2;
 	/* The digitizer covers the main display (backboardd maps it 1:1). */
 	setProperty("DisplayIntegrated", kOSBooleanTrue);
 	setProperty("SurfaceWidth", (unsigned long long)(68 << 16), 32);	/* mm, 16.16 */
@@ -459,7 +459,7 @@
 		return;
 	}
 	x = x < 0 ? 0 : (x > 1079 ? 1079 : x);
-	y = y < 0 ? 0 : (y > 2399 ? 2399 : y);
+	y = y < 0 ? 0 : (y > 2339 ? 2339 : y);
 
 	IOLockLock(fLock);
 	bool was = fDown[finger];
@@ -473,7 +473,7 @@
 	}
 	if (!was && down) {
 		fEdge[finger] = x < SWEET_TOUCH_EDGE_PX || x > 1079 - SWEET_TOUCH_EDGE_PX ||
-		    y < SWEET_TOUCH_EDGE_PX || y > 2399 - SWEET_TOUCH_EDGE_PX;
+		    y < SWEET_TOUCH_EDGE_PX || y > 2339 - SWEET_TOUCH_EDGE_PX;
 	}
 
 	collection = IOHIDEvent::digitizerEvent(now, 0, kIOHIDDigitizerTransducerTypeHand, false, 0, 0, 0);
diff --git a/iokit/Kernel/arm/TopazAdreno.cpp b/iokit/Kernel/arm/TopazAdreno.cpp
--- a/iokit/Kernel/arm/TopazAdreno.cpp
+++ b/iokit/Kernel/arm/TopazAdreno.cpp
@@ -159,8 +159,9 @@
  * reserved regions in the stock DT, not given to the kernel): a pool of it is
  * the GPU's, mapped write-combined (Normal non-cacheable: no cache upkeep).
  */
-#define GPU_POOL_BASE       0x90000000ull
-#define GPU_POOL_SIZE       0x40000000ull       /* 1 GB */
+/* willow: 0x80000000..0x140000000 is XNU kernel RAM; fallback pool sits in clean low DDR 0x64000000..0x7c000000 */
+#define GPU_POOL_BASE       0x64000000ull
+#define GPU_POOL_SIZE       0x18000000ull       /* 384 MB */
 #define GPU_POOL_UNIT       0x10000ull          /* 64 KB */
 #define GPU_POOL_CHUNK      0x4000000ull        /* 64 MB: mapped on first use (1 GB at once is more IO space than there is) */
 #define GPU_POOL_CHUNKS     (GPU_POOL_SIZE / GPU_POOL_CHUNK)
