--- /dev/null
+++ b/iokit/Kernel/arm/SweetCredentialManager.cpp
@@ -0,0 +1,80 @@
+/*
+ * Stub AppleCredentialManager for SWEET.
+ * SpringBoard and security daemons match IOProviderClass=AppleCredentialManager
+ * to instantiate ACM contexts via LibCall_ACMContextCreate. Without this service,
+ * LibCall_ACMContextCreate returns err = -5 causing SpringBoard to abort().
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <sys/proc.h>
+
+class AppleCredentialManager : public IOService {
+	OSDeclareDefaultStructors(AppleCredentialManager);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleCredentialManager, IOService);
+
+bool
+AppleCredentialManager::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleCredentialManagerUserClient");
+	registerService();
+	IOLog("SWEET ACM: AppleCredentialManager registered\n");
+	return true;
+}
+
+class AppleCredentialManagerUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleCredentialManagerUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleCredentialManagerUserClient, IOUserClient);
+
+IOReturn
+AppleCredentialManagerUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleCredentialManagerUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET ACM: %s sel %u in %u/%u out %u/%u\n",
+	    name, selector,
+	    args->scalarInputCount,
+	    args->structureInputDescriptor != NULL ? (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize,
+	    args->scalarOutputCount,
+	    args->structureOutputDescriptor != NULL ? (uint32_t)args->structureOutputDescriptor->getLength() : args->structureOutputSize);
+
+	/* Set dummy success handle / outputs if expected by LibCall_ACMContextCreate */
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 1;
+	}
+	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+#endif
