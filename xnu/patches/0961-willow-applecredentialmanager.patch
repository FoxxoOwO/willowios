+++ b/iokit/KernelConfigTables.cpp
@@ -82,7 +82,12 @@
     "     'IOClass'         = SweetBattery;"
     "     'IOProviderClass' = IOResources;"
     "     'IOMatchCategory' = SweetBattery;"
     "   },"
+    "   {"
+    "     'IOClass'         = AppleCredentialManager;"
