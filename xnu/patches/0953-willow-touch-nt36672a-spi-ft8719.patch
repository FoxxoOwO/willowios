+/*
+ * willow: full-duplex GENI SPI transfer on QUP0 SE2 (spi@4a88000) with manual
+ * active-low CS on GPIO 9 (WEST tile) so multi-word Novatek frames stay in one CS window.
+ */
+static int
+touch_spi_xfer(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	if (st.dead || len == 0 || len > 80) {
+		return EIO;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		return EBUSY;
+	}
+	touch_gpio(WILLOW_PIN_CS, 0, 3, 3, true, false);
+	delay(2);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, SE_TX_LEN, len);
+	touch_wr(st.se, SE_RX_LEN, len);
+	touch_wr(st.se, SE_CMD, (7u << 27)); /* SPI_FULL_DUPLEX */
+
+	unsigned sent = 0, got = 0;
+	for (unsigned iter = 0; iter < 10000; ++iter) {
+		uint32_t irq = touch_irq();
+		while (sent < len && ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) < 8u)) {
+			uint32_t w = 0;
+			for (unsigned b = 0; b < 4 && sent < len; ++b, ++sent) {
+				w |= (uint32_t)(tx ? tx[sent] : 0u) << (8u * b);
+			}
+			touch_wr(st.se, SE_TX, w);
+		}
+		uint32_t rxc = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+		while (rxc--) {
+			uint32_t w = touch_rd(st.se, SE_RX);
+			for (unsigned b = 0; b < 4 && got < len; ++b, ++got) {
+				if (rx) {
+					rx[got] = (uint8_t)(w >> (8u * b));
+				}
+			}
+		}
+		if ((irq & SE_DONE) && got >= len) {
+			touch_wr(st.se, SE_IRQ_CLR, irq);
+			delay(2);
+			touch_gpio(WILLOW_PIN_CS, 0, 3, 3, true, true);
+			return 0;
+		}
+		delay(1);
+	}
+	touch_abort();
+	touch_gpio(WILLOW_PIN_CS, 0, 3, 3, true, true);
+	return ETIMEDOUT;
+}
+
+static int
+touch_nvt_spi_read(uint8_t addr, uint8_t *rx, unsigned len)
+{
+	uint8_t tx_buf[72] = { 0 };
+	uint8_t rx_buf[72] = { 0 };
+	if (len + 2 > sizeof(tx_buf)) {
+		return EINVAL;
+	}
+	tx_buf[0] = addr & 0x7fu; /* SPI_READ_MASK */
+	int err = touch_spi_xfer(tx_buf, rx_buf, len + 2);
+	if (!err) {
+		memcpy(rx + 1, rx_buf + 2, len);
+	}
+	return err;
+}
+
+static int
+touch_nvt_set_page(uint32_t page_addr)
+{
+	uint8_t tx[3] = {
+		0xffu,
+		(uint8_t)((page_addr >> 15) & 0xffu),
+		(uint8_t)((page_addr >> 7) & 0xffu),
+	};
+	return touch_spi_xfer(tx, NULL, sizeof(tx));
+}
+
+/*
+ * Novatek NT36672A SPI 65-byte touch report parser (nt36xxx_spi_c3j):
+ * 6-byte point records at buf[1 + 6 * i]:
+ *   byte 0: [7:3] finger id (1..10), [2:0] status (1=down, 2=move, 3=release)
+ *   byte 1: x[11:4], byte 2: y[11:4], byte 3: [7:4] x[3:0], [3:0] y[3:0]
+ */
+static int
+touch_novatek_spi(void)
+{
+	uint8_t buf[66] = { 0 };
+	int x[TOUCH_MAX] = { 0 }, y[TOUCH_MAX] = { 0 };
+	uint32_t mask = 0;
+
+	int err = touch_nvt_spi_read(0x00, buf, 65);
+	if (err) {
+		return err;
+	}
+	/* All-0x00 or all-0xFF frame when idle/released */
+	bool all_ff = true;
+	for (unsigned i = 1; i <= 6; ++i) {
+		if (buf[i] != 0xffu) {
+			all_ff = false;
+			break;
+		}
+	}
+	if (all_ff) {
+		touch_report(0, st.x, st.y);
+		return 0;
+	}
+	st.s_frames++;
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		const uint8_t *p = &buf[1 + 6 * i];
+		unsigned id = (p[0] >> 3);
+		unsigned status = p[0] & 0x07u;
+		if (id == 0 || id > TOUCH_MAX || (status != 1u && status != 2u)) {
+			continue;
+		}
+		--id;
+		unsigned px = ((unsigned)p[1] << 4) | (p[3] >> 4);
+		unsigned py = ((unsigned)p[2] << 4) | (p[3] & 0x0fu);
+		if (px >= 1080u) {
+			px = 1079u;
+		}
+		if (py >= 2340u) {
+			py = 2339u;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
