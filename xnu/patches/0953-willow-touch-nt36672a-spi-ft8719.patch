+/*
+ * willow: full-duplex GENI SPI transfer on QUP0 SE2 (spi@4a88000) with manual
+ * CS on GPIO 9. DT specifies spi-cs-high, so CS is active HIGH:
+ * Idle: CS=LOW (deasserted), Transfer: CS=HIGH (asserted), Done: CS=LOW.
+ */
+static int
+touch_spi_xfer(const uint8_t *tx, uint8_t *rx, unsigned len)
+{
+	if (st.dead || len == 0 || len > 80) {
+		return EIO;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		return EBUSY;
+	}
+	/* CS asserted HIGH for the whole transaction (spi-cs-high). */
+	touch_gpio(WILLOW_PIN_CS, 0, 3, 3, true, true);
+	delay(2);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, SE_TX_LEN, len);
+	touch_wr(st.se, SE_RX_LEN, len);
+	touch_wr(st.se, SE_CMD, (3u << 27)); /* SPI_FULL_DUPLEX = 3 */
+
+	unsigned sent = 0, got = 0;
+	for (unsigned iter = 0; iter < 500; ++iter) {
+		uint32_t irq = touch_irq();
+		while (sent < len && ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) < 8u)) {
+			uint32_t w = 0;
+			for (unsigned b = 0; b < 4 && sent < len; ++b, ++sent) {
+				w |= (uint32_t)(tx ? tx[sent] : 0u) << (8u * b);
+			}
+			touch_wr(st.se, SE_TX, w);
+		}
+		uint32_t rxc = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+		while (rxc--) {
+			uint32_t w = touch_rd(st.se, SE_RX);
+			for (unsigned b = 0; b < 4 && got < len; ++b, ++got) {
+				if (rx) {
+					rx[got] = (uint8_t)(w >> (8u * b));
+				}
+			}
+		}
+		if ((irq & SE_DONE) && got >= len) {
+			touch_wr(st.se, SE_IRQ_CLR, irq);
+			delay(2);
+			/* CS deasserted LOW after the transaction. */
+			touch_gpio(WILLOW_PIN_CS, 0, 3, 3, true, false);
+			return 0;
+		}
+		delay(1);
+	}
+	touch_abort();
+	/* CS deasserted LOW on timeout as well. */
+	touch_gpio(WILLOW_PIN_CS, 0, 3, 3, true, false);
+	return ETIMEDOUT;
+}
+
+static int
+touch_nvt_spi_read(uint8_t addr, uint8_t *rx, unsigned len)
+{
+	uint8_t tx_buf[72] = { 0 };
+	uint8_t rx_buf[72] = { 0 };
+	if (len + 2 > sizeof(tx_buf)) {
+		return EINVAL;
+	}
+	tx_buf[0] = addr & 0x7fu; /* SPI_READ_MASK */
+	int err = touch_spi_xfer(tx_buf, rx_buf, len + 2);
+	if (!err) {
+		memcpy(rx + 1, rx_buf + 2, len);
+	}
+	return err;
+}
+
+static int
+touch_nvt_set_page(uint32_t page_addr)
+{
+	uint8_t tx[3] = {
+		0xffu,
+		(uint8_t)((page_addr >> 15) & 0xffu),
+		(uint8_t)((page_addr >> 7) & 0xffu),
+	};
+	return touch_spi_xfer(tx, NULL, sizeof(tx));
+}
+
+static int
+touch_nvt_spi_write(uint8_t addr, const uint8_t *data, unsigned len)
+{
+	uint8_t tx[72] = { 0 };
+	if (len + 1 > sizeof(tx)) {
+		return EINVAL;
+	}
+	tx[0] = (addr & 0x7fu) | 0x80u;
+	if (data && len > 0) {
+		memcpy(&tx[1], data, len);
+	}
+	return touch_spi_xfer(tx, NULL, len + 1);
+}
+
+static int
+touch_nvt_download_fw(const void *fw_blob, unsigned fw_size)
+{
+	if (!fw_blob || fw_size < 4) {
+		printf("SWEET TOUCH: no Novatek firmware in /chosen/novatek-fw\n");
+		return ENOENT;
+	}
+	const uint8_t *p = (const uint8_t *)fw_blob;
+	const uint8_t *end = p + fw_size;
+	uint32_t num_sections = *(const uint32_t *)p;
+	p += 4;
+	printf("SWEET TOUCH: downloading Novatek firmware (%u sections, %u bytes)...\n",
+	    num_sections, fw_size);
+
+	/* 0. Engineering reset sequence (page 0x7fff80, reg 0x00 <- 0x5a, wait 20ms) */
+	touch_nvt_set_page(0x7fff80);
+	uint8_t cmd_eng[1] = { 0x5a };
+	touch_nvt_spi_write(0x00, cmd_eng, 1);
+	delay(20000);
+
+	/* 1. Bootloader reset sequence (GPIO 87 is unclaimed in willow DT; use SW reset) */
+	touch_nvt_set_page(0x3f0fe);
+	uint8_t cmd_rst[1] = { 0x69 };
+	touch_nvt_spi_write(0x7e, cmd_rst, 1);
+	delay(20000);
+	touch_nvt_set_page(0x3f310);
+	uint8_t cmd_stop[1] = { 0x00 };
+	touch_nvt_spi_write(0x10, cmd_stop, 1);
+
+	/* 3. Download sections into SRAM */
+	for (uint32_t s = 0; s < num_sections; s++) {
+		if (p + 8 > end) {
+			break;
+		}
+		uint32_t sram_addr = *(const uint32_t *)p;
+		uint32_t length = *(const uint32_t *)(p + 4);
+		p += 8;
+		if (p + length > end) {
+			break;
+		}
+		const uint8_t *payload = p;
+		uint32_t rem = length;
+		uint32_t cur_addr = sram_addr;
+		while (rem > 0) {
+			uint32_t chunk = rem;
+			if (chunk > 64) {
+				chunk = 64;
+			}
+			uint32_t page_rem = 128 - (cur_addr & 0x7fu);
+			if (chunk > page_rem) {
+				chunk = page_rem;
+			}
+			touch_nvt_set_page(cur_addr);
+			uint8_t tx[66];
+			tx[0] = (uint8_t)((cur_addr & 0x7fu) | 0x80u);
+			memcpy(&tx[1], payload, chunk);
+			touch_spi_xfer(tx, NULL, chunk + 1);
+			payload += chunk;
+			cur_addr += chunk;
+			rem -= chunk;
+		}
+		p += (length + 3u) & ~3u;
+	}
+
+	/* 4. Set CRC info for ILM & DLM on page 0x3f100 */
+	touch_nvt_set_page(0x3f100);
+	uint8_t ilm_des[3] = { 0x00, 0x00, 0x00 };
+	touch_nvt_spi_write(0x28, ilm_des, 3);
+	uint8_t ilm_len[2] = { 0x1f, 0xed };
+	touch_nvt_spi_write(0x18, ilm_len, 2);
+	uint8_t ilm_crc[4] = { 0x1d, 0x2f, 0xbb, 0x40 };
+	touch_nvt_spi_write(0x00, ilm_crc, 4);
+
+	uint8_t dlm_des[3] = { 0x00, 0x77, 0x02 };
+	touch_nvt_spi_write(0x2c, dlm_des, 3);
+	uint8_t dlm_len[2] = { 0x17, 0x03 };
+	touch_nvt_spi_write(0x30, dlm_len, 2);
+	uint8_t dlm_crc[4] = { 0x4c, 0x87, 0x25, 0xa5 };
+	touch_nvt_spi_write(0x04, dlm_crc, 4);
+
+	/* 5. CRC enable: page 0x3f30e -> read reg 0x0e, OR with 0x80, write back */
+	touch_nvt_set_page(0x3f30e);
+	uint8_t crc_val[2] = { 0 };
+	touch_nvt_spi_read(0x0e, crc_val, 1);
+	uint8_t crc_en[1] = { (uint8_t)(crc_val[1] | 0x80u) };
+	touch_nvt_spi_write(0x0e, crc_en, 1);
+
+	/* 6. Handshake / FW CRC enable: page 0x21c00 -> write {0x60, 0x00}, write {0x50, 0xae} */
+	touch_nvt_set_page(0x21c00);
+	uint8_t hs0[1] = { 0x00 };
+	touch_nvt_spi_write(0x60, hs0, 1);
+	uint8_t hs1[1] = { 0xae };
+	touch_nvt_spi_write(0x50, hs1, 1);
+
+	/* 7. Boot ready: page 0x3f10d -> write {0x8d, 0x01} -> delay 20ms */
+	touch_nvt_set_page(0x3f10d);
+	uint8_t bld_rdy[1] = { 0x01 };
+	touch_nvt_spi_write(0x0d, bld_rdy, 1);
+	delay(20000);
+
+	/* 8. Check reset state: page 0x21c00 -> poll reg 0x60; wait until buf[1] in 0xa0..0xaf */
+	touch_nvt_set_page(0x21c00);
+	uint8_t rst_buf[6] = { 0 };
+	int rst_ok = 0;
+	for (int i = 0; i < 50; i++) {
+		memset(rst_buf, 0, sizeof(rst_buf));
+		touch_nvt_spi_read(0x60, rst_buf, 5);
+		if (rst_buf[1] >= 0xa0u && rst_buf[1] <= 0xafu) {
+			printf("SWEET TOUCH: Novatek firmware booted OK (reset state=0x%02x, poll %d)\n",
+			    rst_buf[1], i);
+			rst_ok = 1;
+			break;
+		}
+		delay(10000);
+	}
+	if (!rst_ok) {
+		printf("SWEET TOUCH: WARNING: Novatek firmware boot timeout (reset state=0x%02x)\n",
+		    rst_buf[1]);
+	}
+
+	/* 9. Leave page at 0x21c00 for touch_novatek_spi() */
+	touch_nvt_set_page(0x21c00);
+	return rst_ok ? 0 : EIO;
+}
+
+/*
+ * Novatek NT36672A SPI 65-byte touch report parser (nt36xxx_spi_c3j):
+ * 6-byte point records at buf[1 + 6 * i]:
+ *   byte 0: [7:3] finger id (1..10), [2:0] status (1=down, 2=move, 3=release)
+ *   byte 1: x[11:4], byte 2: y[11:4], byte 3: [7:4] x[3:0], [3:0] y[3:0]
+ */
+static int
+touch_novatek_spi(void)
+{
+	uint8_t buf[66] = { 0 };
+	int x[TOUCH_MAX] = { 0 }, y[TOUCH_MAX] = { 0 };
+	uint32_t mask = 0;
+
+	int err = touch_nvt_spi_read(0x00, buf, 65);
+	if (err) {
+		return err;
+	}
+	/* All-0x00 or all-0xFF frame when idle/released */
+	bool all_ff = true;
+	for (unsigned i = 1; i <= 6; ++i) {
+		if (buf[i] != 0xffu) {
+			all_ff = false;
+			break;
+		}
+	}
+	if (all_ff) {
+		touch_report(0, st.x, st.y);
+		return 0;
+	}
+	st.s_frames++;
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		const uint8_t *p = &buf[1 + 6 * i];
+		unsigned id = (p[0] >> 3);
+		unsigned status = p[0] & 0x07u;
+		if (id == 0 || id > TOUCH_MAX || (status != 1u && status != 2u)) {
+			continue;
+		}
+		--id;
+		unsigned px = ((unsigned)p[1] << 4) | (p[3] >> 4);
+		unsigned py = ((unsigned)p[2] << 4) | (p[3] & 0x0fu);
+		if (px >= 1080u) {
+			px = 1079u;
+		}
+		if (py >= 2340u) {
+			py = 2339u;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
