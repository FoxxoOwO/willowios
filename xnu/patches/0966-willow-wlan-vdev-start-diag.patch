+		if (!s_pre_peer) {
+			s_pre_peer = w_peer_addr(CMD_PEER_CREATE, TAG_PEER_CREATE, true, 0u, s_bssid, WMI_PEER_TYPE_STA);
+			LOG("t=%u ms: join: PRE_PEER_CREATE(type=2) %s", g_ms, s_pre_peer ? "ok" : "FAIL");
+		}
+		return w_vdev_start_ex(s_freq, s_bcn, s_dtim, 8u, 2u, is5g ? 4u : 5u, ri1, ri2);
+	} else if (probe == 3) {
+		s_vdev_id = 0;
+		(void)w_send_regdomain(0x37u, 0x199u, 0x130u, 0x40u, 0x40u);   /* CZ / ETSI */
+		(void)w_vdev_param(3u, s_dtim);
+		(void)w_vdev_param(0xdu, s_bcn);
+		(void)w_vdev_param(0x1eu, 0u);
+		(void)w_vdev_param(0x4cu, 1u);
+		(void)w_vdev_param(0x4eu, 1u);
+		(void)w_vdev_param(0x4fu, 1u);
+		return w_vdev_start_ex(s_freq, s_bcn, s_dtim, 8u, 2u, is5g ? 0u : 1u, ri1, ri2);
+	} else if (probe == 4) {
+		if (!s_vdev1_created) {
+			s_vdev1_created = w_vdev_create_id(1u, 0u);
+			LOG("t=%u ms: join: VDEV_CREATE(vdev=1, pdev=0) %s", g_ms, s_vdev1_created ? "ok" : "FAIL");
+		}
+		s_vdev_id = 1u;
+		return w_vdev_start_ex(s_freq, s_bcn, s_dtim, 8u, 2u, is5g ? 8u : 5u, ri1, ri2);
+	} else if (probe == 5) {
