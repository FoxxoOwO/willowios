+		return w_vdev_start_ex(s_freq, s_bcn, s_dtim, 8u, 2u, is5g ? 8u : 5u, ri1, ri2);
+	} else if (probe == 1) {
+		s_vdev_id = 0;
+		if (!s_self_peer) {
+			s_self_peer = w_peer_addr(CMD_PEER_CREATE, TAG_PEER_CREATE, true, 0u, our_mac, 0u);
+			LOG("t=%u ms: join: SELF_PEER_CREATE(type=0) %s", g_ms, s_self_peer ? "ok" : "FAIL");
+		}
