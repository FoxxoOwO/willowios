Subject: [PATCH 958/958] willow: enable gcc sdcc1 clocks, core_mem hc_mode, sdhci card clock with safe divider

--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -290,16 +290,156 @@
 #define SDHCI_INT_DATA_AVAIL    0x00000020u
 #define SDHCI_INT_ERROR         0x00008000u
 
+static vm_offset_t gcc_regs = 0;
+
+static void
+gcc_init_sdcc1(void)
+{
+	if (!gcc_regs) {
+		gcc_regs = ml_io_map(0x01400000u, 0x50000u);
+	}
+	if (!gcc_regs) {
+		printf("SWEET UFS: failed to map GCC\n");
+		return;
+	}
+
+	uint32_t ahb_cbcr = *(volatile uint32_t *)(gcc_regs + 0x16008u);
+	uint32_t apps_cbcr = *(volatile uint32_t *)(gcc_regs + 0x4a010u);
+	uint32_t rcgr_cmd = *(volatile uint32_t *)(gcc_regs + 0x26028u);
+	uint32_t rcgr_cfg = *(volatile uint32_t *)(gcc_regs + 0x2602cu);
+	printf("SWEET UFS: GCC: ahb=%#x apps=%#x (halt=%u en=%u) rcgr_cmd=%#x cfg=%#x\n",
+	       ahb_cbcr, apps_cbcr, (apps_cbcr >> 31) & 1, apps_cbcr & 1, rcgr_cmd, rcgr_cfg);
+
+	/* Enable SDCC1 AHB clock if not enabled */
+	if (!(ahb_cbcr & 1u)) {
+		*(volatile uint32_t *)(gcc_regs + 0x16008u) = ahb_cbcr | 1u;
+	}
+
+	/* Enable SDCC1 APPS branch clock if halted or not enabled */
+	if (!(apps_cbcr & 1u) || (apps_cbcr & (1u << 31))) {
+		*(volatile uint32_t *)(gcc_regs + 0x4a010u) = (apps_cbcr | 1u);
+		for (unsigned i = 0; i < 10000; i++) {
+			if (!(*(volatile uint32_t *)(gcc_regs + 0x4a010u) & (1u << 31))) {
+				break;
+			}
+			delay(10);
+		}
+		printf("SWEET UFS: GCC: apps cbcr after enable: %#x (halt=%u en=%u)\n",
+		       *(volatile uint32_t *)(gcc_regs + 0x4a010u),
+		       (*(volatile uint32_t *)(gcc_regs + 0x4a010u) >> 31) & 1,
+		       *(volatile uint32_t *)(gcc_regs + 0x4a010u) & 1);
+	}
+}
+
+static void
+sdhci_enable_card_clock(void)
+{
+	gcc_init_sdcc1();
+
+	/* Clear CORE_CLK_PWRSAVE (bit 1) in Qualcomm CORE_VENDOR_SPEC (offset 0x20c) */
+	if (su.reg_size >= 0x300u) {
+		uint32_t vspec = *(volatile uint32_t *)(su.regs + 0x20cu);
+		vspec &= ~(1u << 1); /* clear CORE_CLK_PWRSAVE */
+		*(volatile uint32_t *)(su.regs + 0x20cu) = vspec;
+	}
+
+	/* Check core_mem (su.regs + 0x1000): CORE_POWER (0x0) and CORE_HC_MODE (0x78) */
+	if (su.reg_size >= 0x2000u) {
+		uint32_t pwr = *(volatile uint32_t *)(su.regs + 0x1000u);
+		uint32_t hc_mode = *(volatile uint32_t *)(su.regs + 0x1078u);
+		if (!(hc_mode & 1u)) {
+			*(volatile uint32_t *)(su.regs + 0x1078u) = hc_mode | 1u; /* HC_MODE_EN */
+		}
+		printf("SWEET UFS: core_mem: pwr=%#x hc_mode=%#x -> %#x\n",
+		       pwr, hc_mode, *(volatile uint32_t *)(su.regs + 0x1078u));
+	}
+
+	/* Configure SDHCI Clock with safe divider (N = 4, divisor = 8) */
+	uint16_t cur_clk = *(volatile uint16_t *)(su.regs + SDHCI_CLOCK_CONTROL);
+	/* Stop clock */
+	*(volatile uint16_t *)(su.regs + SDHCI_CLOCK_CONTROL) = cur_clk & ~0x0005u;
+	delay(100);
+
+	/* Set divider N = 4 and enable internal clock */
+	uint16_t new_clk = (4u << 8) | 0x0001u;
+	*(volatile uint16_t *)(su.regs + SDHCI_CLOCK_CONTROL) = new_clk;
+	for (unsigned i = 0; i < 10000; i++) {
+		if (*(volatile uint16_t *)(su.regs + SDHCI_CLOCK_CONTROL) & 0x0002u) {
+			break;
+		}
+		delay(10);
+	}
+
+	/* Enable card clock */
+	new_clk = *(volatile uint16_t *)(su.regs + SDHCI_CLOCK_CONTROL) | 0x0004u;
+	*(volatile uint16_t *)(su.regs + SDHCI_CLOCK_CONTROL) = new_clk;
+	__builtin_arm_dsb(0xf);
+	delay(2000);
+}
+
 static void
 sdhci_reset_lines(uint8_t mask)
 {
 	*(volatile uint8_t *)(su.regs + SDHCI_SOFTWARE_RESET) = mask;
 	for (unsigned i = 0; i < 10000; i++) {
-		if (!(ufs_rd(SDHCI_CLOCK_CONTROL) & ((uint32_t)mask << 24))) {
+		if (!(*(volatile uint8_t *)(su.regs + SDHCI_SOFTWARE_RESET) & mask)) {
 			break;
 		}
 		delay(1);
 	}
+	sdhci_enable_card_clock();
+}
+
+static int
+sdhci_cmd_simple(uint16_t cmd_idx, uint32_t arg, uint16_t flags, uint32_t *resp)
+{
+	unsigned wait_us = 0;
+	while (ufs_rd(SDHCI_PRESENT_STATE) & SDHCI_CMD_INHIBIT) {
+		if (++wait_us > 1000000u) {
+			printf("SDHCI: cmd %u inhibit timeout! pstate=%#x\n", cmd_idx, ufs_rd(SDHCI_PRESENT_STATE));
+			sdhci_reset_lines(0x02);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	ufs_wr(SDHCI_INT_STATUS, 0xffffffffu);
+	ufs_wr(SDHCI_ARGUMENT, arg);
+	uint16_t cmd = (uint16_t)((cmd_idx << 8) | flags);
+	*(volatile uint16_t *)(su.regs + SDHCI_TRANSFER_MODE) = 0;
+	__builtin_arm_dsb(0xf);
+	*(volatile uint16_t *)(su.regs + 0x0eu) = cmd;
+	__builtin_arm_dsb(0xf);
+
+	wait_us = 0;
+	while (!(ufs_rd(SDHCI_INT_STATUS) & SDHCI_INT_RESPONSE)) {
+		uint32_t is = ufs_rd(SDHCI_INT_STATUS);
+		if (is & SDHCI_INT_ERROR) {
+			printf("SDHCI: cmd %u error! is=%#x pstate=%#x\n", cmd_idx, is, ufs_rd(SDHCI_PRESENT_STATE));
+			sdhci_reset_lines(0x02);
+			return EIO;
+		}
+		if (++wait_us > 1000000u) {
+			printf("SDHCI: cmd %u resp timeout! is=%#x pstate=%#x\n", cmd_idx, is, ufs_rd(SDHCI_PRESENT_STATE));
+			sdhci_reset_lines(0x02);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	ufs_wr(SDHCI_INT_STATUS, SDHCI_INT_RESPONSE);
+	if (resp) {
+		*resp = ufs_rd(0x10u);
+	}
+	if ((flags & 3u) == 3u) {
+		wait_us = 0;
+		while (ufs_rd(SDHCI_PRESENT_STATE) & SDHCI_DATA_INHIBIT) {
+			if (++wait_us > 2000000u) {
+				printf("SDHCI: cmd %u busy timeout! pstate=%#x\n", cmd_idx, ufs_rd(SDHCI_PRESENT_STATE));
+				break;
+			}
+			delay(1);
+		}
+	}
+	return 0;
 }
 
