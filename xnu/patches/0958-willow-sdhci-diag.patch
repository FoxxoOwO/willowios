Subject: [PATCH 958/958] willow: sdhci 16-bit cmd sequencing, single sector reads and diagnostic logging

--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -308,35 +308,40 @@
 	uint32_t *p = (uint32_t *)buf;
 
 	while (cnt > 0) {
-		uint32_t chunk = MIN(cnt, 4096u);
+		uint32_t chunk = 1; /* single sector transfers for maximum compatibility */
 		unsigned wait_us = 0;
 		while (ufs_rd(SDHCI_PRESENT_STATE) & (SDHCI_CMD_INHIBIT | SDHCI_DATA_INHIBIT)) {
 			if (++wait_us > 5000000u) {
+				printf("SDHCI: inhibit timeout! pstate=%#x is=%#x\n", ufs_rd(SDHCI_PRESENT_STATE), ufs_rd(SDHCI_INT_STATUS));
 				sdhci_reset_lines(0x06);
 				return ETIMEDOUT;
 			}
 			delay(1);
 		}
 		ufs_wr(SDHCI_INT_STATUS, 0xffffffffu);
-		ufs_wr(SDHCI_BLOCK_SIZE, 512u | ((chunk & 0xffffu) << 16));
+		*(volatile uint16_t *)(su.regs + SDHCI_BLOCK_SIZE) = 512u;
+		*(volatile uint16_t *)(su.regs + 0x06u) = 1u;
 		ufs_wr(SDHCI_ARGUMENT, sector);
 
 		uint16_t mode = SDHCI_TRNS_BLK_CNT_EN | (write ? 0u : SDHCI_TRNS_READ);
 		uint16_t cmd_idx = write ? 24u : 17u;
-		if (chunk > 1) {
-			mode |= SDHCI_TRNS_MULTI | SDHCI_TRNS_AUTO_CMD12;
-			cmd_idx = write ? 25u : 18u;
-		}
 		uint16_t cmd = (uint16_t)((cmd_idx << 8) | 0x3au);
-		ufs_wr(SDHCI_TRANSFER_MODE, (uint32_t)mode | ((uint32_t)cmd << 16));
+
+		*(volatile uint16_t *)(su.regs + SDHCI_TRANSFER_MODE) = mode;
+		__builtin_arm_dsb(0xf);
+		*(volatile uint16_t *)(su.regs + 0x0eu) = cmd;
+		__builtin_arm_dsb(0xf);
 
 		wait_us = 0;
 		while (!(ufs_rd(SDHCI_INT_STATUS) & SDHCI_INT_RESPONSE)) {
-			if (ufs_rd(SDHCI_INT_STATUS) & SDHCI_INT_ERROR) {
+			uint32_t is = ufs_rd(SDHCI_INT_STATUS);
+			if (is & SDHCI_INT_ERROR) {
+				printf("SDHCI: CMD%u error! is=%#x pstate=%#x\n", cmd_idx, is, ufs_rd(SDHCI_PRESENT_STATE));
 				sdhci_reset_lines(0x06);
 				return EIO;
 			}
 			if (++wait_us > 5000000u) {
+				printf("SDHCI: CMD%u resp timeout! is=%#x pstate=%#x sector=%u\n", cmd_idx, is, ufs_rd(SDHCI_PRESENT_STATE), sector);
 				sdhci_reset_lines(0x06);
 				return ETIMEDOUT;
 			}
@@ -346,39 +351,43 @@
 
 		uint32_t pmask = write ? SDHCI_SPACE_AVAILABLE : SDHCI_DATA_AVAILABLE;
 		uint32_t imask = write ? SDHCI_INT_SPACE_AVAIL : SDHCI_INT_DATA_AVAIL;
-		for (uint32_t s = 0; s < chunk; s++) {
-			wait_us = 0;
-			while (!(ufs_rd(SDHCI_PRESENT_STATE) & pmask) &&
-			       !(ufs_rd(SDHCI_INT_STATUS) & imask)) {
-				if (ufs_rd(SDHCI_INT_STATUS) & SDHCI_INT_ERROR) {
-					sdhci_reset_lines(0x06);
-					return EIO;
-				}
-				if (++wait_us > 5000000u) {
-					sdhci_reset_lines(0x06);
-					return ETIMEDOUT;
-				}
-				delay(1);
-			}
-			ufs_wr(SDHCI_INT_STATUS, imask);
-			if (write) {
-				for (unsigned w = 0; w < 512u / 4u; w++) {
-					ufs_wr(SDHCI_BUFFER, *p++);
-				}
-			} else {
-				for (unsigned w = 0; w < 512u / 4u; w++) {
-					*p++ = ufs_rd(SDHCI_BUFFER);
-				}
+		wait_us = 0;
+		while (!(ufs_rd(SDHCI_PRESENT_STATE) & pmask) &&
+		       !(ufs_rd(SDHCI_INT_STATUS) & imask)) {
+			uint32_t is = ufs_rd(SDHCI_INT_STATUS);
+			if (is & SDHCI_INT_ERROR) {
+				printf("SDHCI: DATA error! is=%#x pstate=%#x\n", is, ufs_rd(SDHCI_PRESENT_STATE));
+				sdhci_reset_lines(0x06);
+				return EIO;
+			}
+			if (++wait_us > 5000000u) {
+				printf("SDHCI: DATA avail timeout! is=%#x pstate=%#x\n", is, ufs_rd(SDHCI_PRESENT_STATE));
+				sdhci_reset_lines(0x06);
+				return ETIMEDOUT;
+			}
+			delay(1);
+		}
+		ufs_wr(SDHCI_INT_STATUS, imask);
+		if (write) {
+			for (unsigned w = 0; w < 512u / 4u; w++) {
+				ufs_wr(SDHCI_BUFFER, *p++);
+			}
+		} else {
+			for (unsigned w = 0; w < 512u / 4u; w++) {
+				*p++ = ufs_rd(SDHCI_BUFFER);
 			}
 		}
 
 		wait_us = 0;
 		while (!(ufs_rd(SDHCI_INT_STATUS) & SDHCI_INT_DATA_END)) {
-			if (ufs_rd(SDHCI_INT_STATUS) & SDHCI_INT_ERROR) {
+			uint32_t is = ufs_rd(SDHCI_INT_STATUS);
+			if (is & SDHCI_INT_ERROR) {
+				printf("SDHCI: DATA_END error! is=%#x pstate=%#x\n", is, ufs_rd(SDHCI_PRESENT_STATE));
 				sdhci_reset_lines(0x06);
 				return EIO;
 			}
 			if (++wait_us > 5000000u) {
+				printf("SDHCI: DATA_END timeout! is=%#x pstate=%#x\n", is, ufs_rd(SDHCI_PRESENT_STATE));
 				break;
 			}
 			delay(1);
@@ -672,6 +681,7 @@
 		*(volatile uint8_t *)(su.regs + SDHCI_HOST_CONTROL) = hctrl & ~0x18u;
 		uint16_t hc2 = *(volatile uint16_t *)(su.regs + SDHCI_HOST_CONTROL2);
 		*(volatile uint16_t *)(su.regs + SDHCI_HOST_CONTROL2) = hc2 & ~(1u << 12);
+		printf("SWEET UFS: init: hctrl=%#x hc2=%#x clk=%#x pstate=%#x cqcfg=%#x\n", *(volatile uint8_t *)(su.regs + SDHCI_HOST_CONTROL), *(volatile uint16_t *)(su.regs + SDHCI_HOST_CONTROL2), ufs_rd(SDHCI_CLOCK_CONTROL), ufs_rd(SDHCI_PRESENT_STATE), (su.reg_size >= 0x2000u) ? *(volatile uint32_t *)(su.regs + 0x1008u) : 0);
 		printf("SWEET UFS: willow SDHCI eMMC host ready (pstate=%#x)\n", ufs_rd(SDHCI_PRESENT_STATE));
 		return 0;
 	}
