Subject: [PATCH 958/958] willow: sdhci strictly 32-bit dword aligned accesses, card clock enable, and hc_mode

--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -291,15 +291,108 @@
 #define SDHCI_INT_ERROR         0x00008000u
 
 static void
+sdhci_enable_card_clock(void)
+{
+	/* Clear CORE_CLK_PWRSAVE (bit 1) in Qualcomm CORE_VENDOR_SPEC (offset 0x20c) */
+	if (su.reg_size >= 0x300u) {
+		uint32_t vspec = ufs_rd(0x20cu);
+		vspec &= ~(1u << 1); /* clear CORE_CLK_PWRSAVE */
+		ufs_wr(0x20cu, vspec);
+	}
+
+	/* Check core_mem (su.regs + 0x1000): CORE_HC_MODE (0x1078) */
+	if (su.reg_size >= 0x2000u) {
+		uint32_t hc_mode = ufs_rd(0x1078u);
+		if (!(hc_mode & 1u)) {
+			ufs_wr(0x1078u, hc_mode | 1u); /* HC_MODE_EN */
+		}
+	}
+
+	/* Enable SDHCI Card Clock (SDHCI_CLOCK_CARD_EN = 0x0004) via 32-bit dword access */
+	uint32_t clk_reg = ufs_rd(SDHCI_CLOCK_CONTROL);
+	if (!(clk_reg & 0x0001u)) {
+		clk_reg |= 0x0001u;
+		ufs_wr(SDHCI_CLOCK_CONTROL, clk_reg);
+		for (unsigned i = 0; i < 10000; i++) {
+			if (ufs_rd(SDHCI_CLOCK_CONTROL) & 0x0002u) {
+				break;
+			}
+			delay(10);
+		}
+	}
+	clk_reg = ufs_rd(SDHCI_CLOCK_CONTROL);
+	clk_reg |= 0x0004u; /* SDHCI_CLOCK_CARD_EN */
+	ufs_wr(SDHCI_CLOCK_CONTROL, clk_reg);
+	__builtin_arm_dsb(0xf);
+	delay(2000);
+}
+
+static void
 sdhci_reset_lines(uint8_t mask)
 {
-	*(volatile uint8_t *)(su.regs + SDHCI_SOFTWARE_RESET) = mask;
+	/* SDHCI_SOFTWARE_RESET is byte 3 of SDHCI_CLOCK_CONTROL (offset 0x2C).
+	 * Read-modify-write via aligned 32-bit dword. */
+	uint32_t reg = ufs_rd(SDHCI_CLOCK_CONTROL);
+	reg |= ((uint32_t)mask << 24);
+	ufs_wr(SDHCI_CLOCK_CONTROL, reg);
 	for (unsigned i = 0; i < 10000; i++) {
 		if (!(ufs_rd(SDHCI_CLOCK_CONTROL) & ((uint32_t)mask << 24))) {
 			break;
 		}
 		delay(1);
 	}
+	sdhci_enable_card_clock();
+}
+
+static int
+sdhci_cmd_simple(uint16_t cmd_idx, uint32_t arg, uint16_t flags, uint32_t *resp)
+{
+	unsigned wait_us = 0;
+	while (ufs_rd(SDHCI_PRESENT_STATE) & SDHCI_CMD_INHIBIT) {
+		if (++wait_us > 1000000u) {
+			printf("SDHCI: cmd %u inhibit timeout! pstate=%#x\n", cmd_idx, ufs_rd(SDHCI_PRESENT_STATE));
+			sdhci_reset_lines(0x02);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	ufs_wr(SDHCI_INT_STATUS, 0xffffffffu);
+	ufs_wr(SDHCI_ARGUMENT, arg);
+	uint32_t cmd = (uint32_t)((cmd_idx << 8) | flags);
+	/* Aligned 32-bit dword write at 0x0C: transfer_mode=0 (bits 15:0), command=cmd (bits 31:16) */
+	ufs_wr(SDHCI_TRANSFER_MODE, cmd << 16);
+	__builtin_arm_dsb(0xf);
+
+	wait_us = 0;
+	while (!(ufs_rd(SDHCI_INT_STATUS) & SDHCI_INT_RESPONSE)) {
+		uint32_t is = ufs_rd(SDHCI_INT_STATUS);
+		if (is & SDHCI_INT_ERROR) {
+			printf("SDHCI: cmd %u error! is=%#x pstate=%#x\n", cmd_idx, is, ufs_rd(SDHCI_PRESENT_STATE));
+			sdhci_reset_lines(0x02);
+			return EIO;
+		}
+		if (++wait_us > 1000000u) {
+			printf("SDHCI: cmd %u resp timeout! is=%#x pstate=%#x\n", cmd_idx, is, ufs_rd(SDHCI_PRESENT_STATE));
+			sdhci_reset_lines(0x02);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	ufs_wr(SDHCI_INT_STATUS, SDHCI_INT_RESPONSE);
+	if (resp) {
+		*resp = ufs_rd(0x10u);
+	}
+	if ((flags & 3u) == 3u) {
+		wait_us = 0;
+		while (ufs_rd(SDHCI_PRESENT_STATE) & SDHCI_DATA_INHIBIT) {
+			if (++wait_us > 2000000u) {
+				printf("SDHCI: cmd %u busy timeout! pstate=%#x\n", cmd_idx, ufs_rd(SDHCI_PRESENT_STATE));
+				break;
+			}
+			delay(1);
+		}
+	}
+	return 0;
 }
 
