Subject: [PATCH 958/958] willow: sdhci 8-bit bus width, 1.8V bus power, auto-calibration and diag

--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -290,16 +290,112 @@
 #define SDHCI_INT_DATA_AVAIL    0x00000020u
 #define SDHCI_INT_ERROR         0x00008000u
 
+static uint8_t g_sdhci_width = 0x20;
+static uint16_t g_sdhci_div = 8;
+static int g_sdhci_calib = 1;
+
+static void
+sdhci_set_config(uint8_t width, uint16_t clk_div)
+{
+	/* Clear CORE_CLK_PWRSAVE (bit 1) in Qualcomm CORE_VENDOR_SPEC (offset 0x20c) */
+	if (su.reg_size >= 0x300u) {
+		uint32_t vspec = ufs_rd(0x20cu);
+		vspec &= ~(1u << 1); /* clear CORE_CLK_PWRSAVE */
+		ufs_wr(0x20cu, vspec);
+	}
+
+	/* Turn on SD Bus Power: 1.8V (0x0A) | POWER_ON (0x01) = 0x0B in byte 1 */
+	uint32_t hctrl = (0x0Bu << 8) | (uint32_t)width;
+	ufs_wr(SDHCI_HOST_CONTROL, hctrl);
+
+	/* Stop clock, configure divider and max timeout (0x0E) */
+	ufs_wr(SDHCI_CLOCK_CONTROL, (0x0Eu << 16));
+	delay(100);
+
+	uint32_t clk_cfg = ((uint32_t)clk_div << 8) | 0x0001u | (0x0Eu << 16);
+	ufs_wr(SDHCI_CLOCK_CONTROL, clk_cfg);
+	for (unsigned i = 0; i < 10000; i++) {
+		if (ufs_rd(SDHCI_CLOCK_CONTROL) & 0x0002u) {
+			break;
+		}
+		delay(10);
+	}
+
+	/* Enable card clock */
+	clk_cfg |= 0x0004u;
+	ufs_wr(SDHCI_CLOCK_CONTROL, clk_cfg);
+	__builtin_arm_dsb(0xf);
+	delay(2000);
+}
+
 static void
 sdhci_reset_lines(uint8_t mask)
 {
-	*(volatile uint8_t *)(su.regs + SDHCI_SOFTWARE_RESET) = mask;
+	uint32_t reg = ufs_rd(SDHCI_CLOCK_CONTROL);
+	reg |= ((uint32_t)mask << 24);
+	ufs_wr(SDHCI_CLOCK_CONTROL, reg);
 	for (unsigned i = 0; i < 10000; i++) {
 		if (!(ufs_rd(SDHCI_CLOCK_CONTROL) & ((uint32_t)mask << 24))) {
 			break;
 		}
 		delay(1);
 	}
+	sdhci_set_config(g_sdhci_width, g_sdhci_div);
+}
+
+static int
+sdhci_cmd_simple(uint16_t cmd_idx, uint32_t arg, uint16_t flags, uint32_t *resp)
+{
+	unsigned wait_us = 0;
+	while (ufs_rd(SDHCI_PRESENT_STATE) & SDHCI_CMD_INHIBIT) {
+		if (++wait_us > 1000000u) {
+			if (!g_sdhci_calib) {
+				printf("SDHCI: cmd %u inhibit timeout! pstate=%#x is=%#x\n", cmd_idx, ufs_rd(SDHCI_PRESENT_STATE), ufs_rd(SDHCI_INT_STATUS));
+			}
+			sdhci_reset_lines(0x02);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	ufs_wr(SDHCI_INT_STATUS, 0xffffffffu);
+	ufs_wr(SDHCI_ARGUMENT, arg);
+	uint32_t cmd = (uint32_t)((cmd_idx << 8) | flags);
+	ufs_wr(SDHCI_TRANSFER_MODE, cmd << 16);
+	__builtin_arm_dsb(0xf);
+
+	wait_us = 0;
+	while (!(ufs_rd(SDHCI_INT_STATUS) & SDHCI_INT_RESPONSE)) {
+		uint32_t is = ufs_rd(SDHCI_INT_STATUS);
+		if (is & SDHCI_INT_ERROR) {
+			if (!g_sdhci_calib) {
+				printf("SDHCI: cmd %u error! is=%#x pstate=%#x\n", cmd_idx, is, ufs_rd(SDHCI_PRESENT_STATE));
+			}
+			sdhci_reset_lines(0x02);
+			return EIO;
+		}
+		if (++wait_us > 1000000u) {
+			if (!g_sdhci_calib) {
+				printf("SDHCI: cmd %u resp timeout! is=%#x pstate=%#x\n", cmd_idx, is, ufs_rd(SDHCI_PRESENT_STATE));
+			}
+			sdhci_reset_lines(0x02);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	ufs_wr(SDHCI_INT_STATUS, SDHCI_INT_RESPONSE);
+	if (resp) {
+		*resp = ufs_rd(0x10u);
+	}
+	if ((flags & 3u) == 3u) {
+		wait_us = 0;
+		while (ufs_rd(SDHCI_PRESENT_STATE) & SDHCI_DATA_INHIBIT) {
+			if (++wait_us > 2000000u) {
+				break;
+			}
+			delay(1);
+		}
+	}
+	return 0;
 }
 
