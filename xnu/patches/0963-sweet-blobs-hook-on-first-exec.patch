From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: x <x@x>
Subject: sweet: install the payload files on the first exec (root is up, process context)

---
 bsd/kern/kern_exec.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7414,4 +7414,7 @@
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 			/* SWEET runs every iOS binary this way: one short line per exec. */
 			printf("exec %s\n", p->p_name);
+			/* sweet: the files the boot payload carries (the GL shim) go on the root once */
+			extern void sweet_install_blobs(void);
+			sweet_install_blobs();
 			/* topaz: does the window server get our library (GPU's OpenGL ES)? */
