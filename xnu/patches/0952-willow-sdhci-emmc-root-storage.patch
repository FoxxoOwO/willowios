+/*
+ * willow (SM6125 "trinket"): internal storage is eMMC 5.1 on sdhci@4744000
+ * (hc_mem @ +0x0000, cmdq_mem @ +0x1000). Polled PIO transfers over 512-byte
+ * hardware sectors, translating each 4 KiB UFS_BLOCK into 8 x 512B sectors.
+ */
+#define SDHCI_BLOCK_SIZE        0x04u
+#define SDHCI_ARGUMENT          0x08u
+#define SDHCI_TRANSFER_MODE     0x0cu
+#define SDHCI_BUFFER            0x20u
+#define SDHCI_PRESENT_STATE     0x24u
+#define SDHCI_HOST_CONTROL      0x28u
+#define SDHCI_CLOCK_CONTROL     0x2cu
+#define SDHCI_SOFTWARE_RESET    0x2fu
+#define SDHCI_INT_STATUS        0x30u
+#define SDHCI_INT_ENABLE        0x34u
+#define SDHCI_SIGNAL_ENABLE     0x38u
+#define SDHCI_HOST_CONTROL2     0x3eu
+
+#define SDHCI_CMD_INHIBIT       0x00000001u
+#define SDHCI_DATA_INHIBIT      0x00000002u
+#define SDHCI_SPACE_AVAILABLE   0x00000400u
+#define SDHCI_DATA_AVAILABLE    0x00000800u
+#define SDHCI_TRNS_BLK_CNT_EN   0x0002u
+#define SDHCI_TRNS_AUTO_CMD12   0x0004u
+#define SDHCI_TRNS_READ         0x0010u
+#define SDHCI_TRNS_MULTI        0x0020u
+#define SDHCI_INT_RESPONSE      0x00000001u
+#define SDHCI_INT_DATA_END      0x00000002u
+#define SDHCI_INT_SPACE_AVAIL   0x00000010u
+#define SDHCI_INT_DATA_AVAIL    0x00000020u
+#define SDHCI_INT_ERROR         0x00008000u
+
+static void
+sdhci_reset_lines(uint8_t mask)
+{
+	*(volatile uint8_t *)(su.regs + SDHCI_SOFTWARE_RESET) = mask;
+	for (unsigned i = 0; i < 10000; i++) {
+		if (!(ufs_rd(SDHCI_CLOCK_CONTROL) & ((uint32_t)mask << 24))) {
+			break;
+		}
+		delay(1);
+	}
+}
+
+static int
+sdhci_rw_sectors(uint32_t sector, uint32_t cnt, void *buf, bool write)
+{
+	uint32_t *p = (uint32_t *)buf;
+
+	while (cnt > 0) {
+		uint32_t chunk = MIN(cnt, 4096u);
+		unsigned wait_us = 0;
+		while (ufs_rd(SDHCI_PRESENT_STATE) & (SDHCI_CMD_INHIBIT | SDHCI_DATA_INHIBIT)) {
+			if (++wait_us > 5000000u) {
+				sdhci_reset_lines(0x06);
+				return ETIMEDOUT;
+			}
+			delay(1);
+		}
+		ufs_wr(SDHCI_INT_STATUS, 0xffffffffu);
+		ufs_wr(SDHCI_BLOCK_SIZE, 512u | ((chunk & 0xffffu) << 16));
+		ufs_wr(SDHCI_ARGUMENT, sector);
+
+		uint16_t mode = SDHCI_TRNS_BLK_CNT_EN | (write ? 0u : SDHCI_TRNS_READ);
+		uint16_t cmd_idx = write ? 24u : 17u;
+		if (chunk > 1) {
+			mode |= SDHCI_TRNS_MULTI | SDHCI_TRNS_AUTO_CMD12;
+			cmd_idx = write ? 25u : 18u;
+		}
+		uint16_t cmd = (uint16_t)((cmd_idx << 8) | 0x3au);
+		ufs_wr(SDHCI_TRANSFER_MODE, (uint32_t)mode | ((uint32_t)cmd << 16));
+
+		wait_us = 0;
+		while (!(ufs_rd(SDHCI_INT_STATUS) & SDHCI_INT_RESPONSE)) {
+			if (ufs_rd(SDHCI_INT_STATUS) & SDHCI_INT_ERROR) {
+				sdhci_reset_lines(0x06);
+				return EIO;
+			}
+			if (++wait_us > 5000000u) {
+				sdhci_reset_lines(0x06);
+				return ETIMEDOUT;
+			}
+			delay(1);
+		}
+		ufs_wr(SDHCI_INT_STATUS, SDHCI_INT_RESPONSE);
+
+		uint32_t pmask = write ? SDHCI_SPACE_AVAILABLE : SDHCI_DATA_AVAILABLE;
+		uint32_t imask = write ? SDHCI_INT_SPACE_AVAIL : SDHCI_INT_DATA_AVAIL;
+		for (uint32_t s = 0; s < chunk; s++) {
+			wait_us = 0;
+			while (!(ufs_rd(SDHCI_PRESENT_STATE) & pmask) &&
+			       !(ufs_rd(SDHCI_INT_STATUS) & imask)) {
+				if (ufs_rd(SDHCI_INT_STATUS) & SDHCI_INT_ERROR) {
+					sdhci_reset_lines(0x06);
+					return EIO;
+				}
+				if (++wait_us > 5000000u) {
+					sdhci_reset_lines(0x06);
+					return ETIMEDOUT;
+				}
+				delay(1);
+			}
+			ufs_wr(SDHCI_INT_STATUS, imask);
+			if (write) {
+				for (unsigned w = 0; w < 512u / 4u; w++) {
+					ufs_wr(SDHCI_BUFFER, *p++);
+				}
+			} else {
+				for (unsigned w = 0; w < 512u / 4u; w++) {
+					*p++ = ufs_rd(SDHCI_BUFFER);
+				}
+			}
+		}
+
+		wait_us = 0;
+		while (!(ufs_rd(SDHCI_INT_STATUS) & SDHCI_INT_DATA_END)) {
+			if (ufs_rd(SDHCI_INT_STATUS) & SDHCI_INT_ERROR) {
+				sdhci_reset_lines(0x06);
+				return EIO;
+			}
+			if (++wait_us > 5000000u) {
+				break;
+			}
+			delay(1);
+		}
+		ufs_wr(SDHCI_INT_STATUS, 0xffffffffu);
+		sector += chunk;
+		cnt -= chunk;
+	}
+	return 0;
+}
